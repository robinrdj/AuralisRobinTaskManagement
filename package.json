{
  "name": "auralis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Auralis — a real-time, full-stack task management board.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev --workspace @auralis/web",
    "dev:api": "npm run dev --workspace @auralis/api",
    "build": "npm run build --workspace @auralis/shared && npm run build --workspace @auralis/api && npm run build --workspace @auralis/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "db:generate": "npm run db:generate --workspace @auralis/api",
    "db:migrate": "npm run db:migrate --workspace @auralis/api",
    "db:seed": "npm run db:seed --workspace @auralis/api",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.11.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.5"
  }
}
