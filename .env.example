# Copy to .env and fill in. Everything here has a working default in
# development, so `npm run dev` needs no setup at all.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset in development: the API falls back to PGlite, an in-process
# Postgres, so there is nothing to install and nothing to run. Data does not
# survive a restart, which is what you want while iterating.
#
# In production this must point at a real Postgres. Neon's free tier works:
#   DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/auralis?sslmode=require
DATABASE_URL=

# Connections held open per instance. Managed Postgres plans cap this low.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs access and refresh tokens. REQUIRED in production, and the process
# refuses to start without at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every existing session.
JWT_SECRET=

# How long an access token lives. Short by design — the client refreshes
# silently, and a leaked token expires quickly.
ACCESS_TOKEN_TTL=15m

# How long a refresh token family lives before a full re-login is required.
REFRESH_TOKEN_TTL_DAYS=30

# How long a no-signup demo account and its board survive before being reaped.
GUEST_TTL_HOURS=72

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to send credentialed requests. This is the
# CSRF boundary as much as the CORS one, so keep it tight.
#   CORS_ORIGINS=https://auralis.example.com
CORS_ORIGINS=http://localhost:5173
